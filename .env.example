# ══════════════════════════════════════════════════════════════════════════════
# Gainwell CHAMP · Spot Recognition Tool — environment configuration
#
# Copy this file to .env and adjust. EVERY value has a safe local-development
# default, so the app runs with NO .env file at all:
#   SQLite database · console email (OTP printed to terminal + login page)
#   WhatsApp simulator (in-app phone) · demo employee directory
#
# PRODUCTION (AWS): do not put secrets in .env — load them from AWS Secrets
# Manager (see server/src/aws/secretsManager.ts and deploy/README-deploy.md).
# ══════════════════════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
# Secret used to sign session cookies. REQUIRED in production (app refuses to
# boot with the dev default).
SESSION_SECRET=dev-insecure-secret-change-me
# Idle and absolute session lifetimes for the web console login.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# All calendar logic (monthly cap reset, digests, display times) uses IST.
DISPLAY_TIMEZONE=Asia/Kolkata

# ── Database ──────────────────────────────────────────────────────────────────
# OPTION 1 — Zero-config SQLite (default):
DATABASE_CLIENT=better-sqlite3
SQLITE_FILE=./data/champ.sqlite3

# OPTION 2 — MySQL / phpMyAdmin (XAMPP / WAMP / standalone MySQL):
# DATABASE_CLIENT=mysql2
# DATABASE_URL=mysql://root:@127.0.0.1:3306/champ_db

# OPTION 3 — Production PostgreSQL (AWS RDS):
# DATABASE_CLIENT=pg
# DATABASE_URL=postgres://champ:<password>@<rds-endpoint>.ap-south-1.rds.amazonaws.com:5432/champ

# ── Web console login (company-email OTP) ─────────────────────────────────────
# Only this email domain may request an OTP (architecture §3.4).
ALLOWED_EMAIL_DOMAIN=gainwellengineering.com
# Comma-separated allowlists that grant console roles. These are upserted into
# the admin_users table at boot. The demo directory includes employees with
# these two addresses, so you can log in locally out of the box.
ADMIN_EMAILS=hr.admin@gainwellengineering.com
COMMITTEE_EMAILS=rnr.committee@gainwellengineering.com
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Email delivery (OTP + digests) ────────────────────────────────────────────
# LOCAL DEFAULT: "console" — the OTP is printed to the server terminal and (in
# console mode only) returned to the login page so you can test easily.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@gainwellengineering.com

# OPTION 1 — company SMTP (ask IT; needs SPF/DKIM/DMARC on the domain):
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gainwellengineering.com
# SMTP_PORT=587
# SMTP_USER=no-reply@gainwellengineering.com
# SMTP_PASS=<password>
# SMTP_SECURE=false

# OPTION 2 — Amazon SES (production on AWS; verify the sender + domain first):
# EMAIL_PROVIDER=ses
# AWS_REGION=ap-south-1
# (SES uses the runtime IAM role — no keys needed on AWS. See modules/auth/mailer.ts)

# ── WhatsApp Business Platform ────────────────────────────────────────────────
# LOCAL DEFAULT: "simulator" — the in-app phone at /simulator exercises the
# exact same conversation engine; no Meta account needed.
WHATSAPP_PROVIDER=simulator

# PRODUCTION — Meta Cloud API (or a BSP such as Gupshup/Wati/Twilio; see
# README §Enabling WhatsApp). Obtain from Meta Business Manager /
# developers.facebook.com after Business Verification:
# WHATSAPP_PROVIDER=meta
# META_WA_API_VERSION=v20.0
# META_WA_PHONE_NUMBER_ID=<phone-number-id>
# META_WA_TOKEN=<system-user-permanent-access-token>
# META_WA_APP_SECRET=<app-secret-for-webhook-signature-verification>
# META_WA_VERIFY_TOKEN=<any-random-string-you-also-paste-into-the-meta-console>

# OPTION 2 — Gallabox WhatsApp API (https://server.gallabox.com):
# WHATSAPP_PROVIDER=gallabox
# GALLABOX_BASE_URL=https://server.gallabox.com
# GALLABOX_API_KEY=<gallabox-api-key>
# GALLABOX_API_SECRET=<gallabox-api-secret>
# GALLABOX_CHANNEL_ID=<gallabox-whatsapp-channel-id>
# GALLABOX_WEBHOOK_SECRET=<gallabox-webhook-secret>

# ── DarwinBox HRIS sync ───────────────────────────────────────────────────────
# LOCAL DEFAULT: disabled — the app seeds a demo employee directory instead.
DARWINBOX_ENABLED=false
# PRODUCTION — from the DarwinBox admin console / account manager:
# DARWINBOX_ENABLED=true
# DARWINBOX_BASE_URL=https://<tenant>.darwinbox.in
# DARWINBOX_BASIC_AUTH_USER=<username>
# DARWINBOX_BASIC_AUTH_PASS=<password>
# DARWINBOX_API_KEY=<api-key-for-payload>
# DARWINBOX_REPORT_ID=<report-id>

# ── Plant board ───────────────────────────────────────────────────────────────
# The /board page is read-only and login-free (it runs on a kiosk browser).
# Optionally require a token so only the plant screens can load it:
# BOARD_TOKEN=<random-string>   → board URL becomes /board?token=<random-string>

# ── Dev tools ─────────────────────────────────────────────────────────────────
# The WhatsApp simulator API+page. Defaults ON outside production, OFF in
# production. Force with:
# ENABLE_SIMULATOR=true

# ── Scheduled jobs (cron, IST) ────────────────────────────────────────────────
SYNC_CRON=30 2 * * *
FLAGSCAN_CRON=15 3 * * *
DIGEST_CRON=0 9 * * 1

# ── AWS (production only — all commented for local runs) ─────────────────────
# AWS_REGION=ap-south-1
# Load every secret (DB URL, WhatsApp token, SMTP password…) from AWS Secrets
# Manager at boot instead of from this file:
# AWS_SECRETS_ENABLED=true
# AWS_SECRETS_ID=champ-spot-tool/production
