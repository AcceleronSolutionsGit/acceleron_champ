# ══════════════════════════════════════════════════════════════════════════════
# Gainwell CHAMP · Spot Recognition Tool — environment configuration
#
# Copy this file to .env and adjust. EVERY value has a safe local-development
# default, so the app runs with NO .env file at all:
#   SQLite database · console email (OTP printed to terminal + login page)
#   WhatsApp simulator (in-app phone) · demo employee directory
#
# PRODUCTION (AWS): do not put secrets in .env — load them from AWS Secrets
# Manager (see server/src/aws/secretsManager.ts and deploy/README-deploy.md).
# ══════════════════════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
# Secret used to sign session cookies. REQUIRED in production (app refuses to
# boot with the dev default).
SESSION_SECRET=dev-insecure-secret-change-me
# Idle and absolute session lifetimes for the web console login.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# All calendar logic (monthly cap reset, digests, display times) uses IST.
DISPLAY_TIMEZONE=Asia/Kolkata

# ── Database ──────────────────────────────────────────────────────────────────
# OPTION 1 — Zero-config SQLite (default):
DATABASE_CLIENT=better-sqlite3
SQLITE_FILE=./data/champ.sqlite3

# OPTION 2 — MySQL / phpMyAdmin (XAMPP / WAMP / standalone MySQL):
# DATABASE_CLIENT=mysql2
# DATABASE_URL=mysql://root:@127.0.0.1:3306/champ_db

# OPTION 3 — Production PostgreSQL (AWS RDS):
# DATABASE_CLIENT=pg
# DATABASE_URL=postgres://champ:<password>@<rds-endpoint>.ap-south-1.rds.amazonaws.com:5432/champ

# ── Web console login (company-email OTP) ─────────────────────────────────────
# Only this email domain may request an OTP (architecture §3.4).
ALLOWED_EMAIL_DOMAIN=gainwellengineering.com
# Comma-separated allowlists that grant console roles. These are upserted into
# the admin_users table at boot. The demo directory includes employees with
# these two addresses, so you can log in locally out of the box.
ADMIN_EMAILS=hr.admin@gainwellengineering.com
COMMITTEE_EMAILS=rnr.committee@gainwellengineering.com
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Email delivery (sign-in codes) ────────────────────────────────────────────
# The console sends two kinds of mail: the 6-digit sign-in code, and the
# recognition mail (recipient in To, their reporting manager and the giver in
# Cc). If mail does not work, nobody can sign in, so treat this as
# load-bearing.
#
# LOCAL DEFAULT: "console" — the code is printed to the server terminal and
# shown on the login page, so you can test without sending anything.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@acceleronsolutions.io

# ── PRODUCTION: Microsoft 365 / Exchange Online ──────────────────────────────
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false              # 587 is STARTTLS, not implicit TLS
# SMTP_USER=no-reply@acceleronsolutions.io
# SMTP_PASS=<app password, or the mailbox password if MFA is off>
# EMAIL_FROM=no-reply@acceleronsolutions.io
#
# Three things have to be true on the tenant, and none of them are the default:
#
#   1. The mailbox exists and is licensed. M365 will not authenticate a shared
#      mailbox with no licence.
#
#   2. Authenticated SMTP is ENABLED for it. Microsoft turns SMTP AUTH off
#      tenant-wide by default. Turn it on in:
#        Microsoft 365 admin centre → Users → Active users → the mailbox →
#        Mail → Manage email apps → tick "Authenticated SMTP"
#      and check it is not blocked tenant-wide in:
#        Exchange admin centre → Settings → Mail flow
#
#   3. EMAIL_FROM is the SAME address as SMTP_USER, or that mailbox has been
#      granted "Send As" on it. Otherwise M365 rejects with
#      "550 5.7.60 Client does not have permissions to send as this sender".
#      Leaving EMAIL_FROM unset makes it fall back to SMTP_USER, which is safe.
#
# If the tenant has MFA or security defaults on (it should), the account
# password will NOT work — create an app password for the mailbox, or ask IT
# to set up a high-volume / SMTP relay connector instead.
#
# Verify before going live, ON THE SERVER rather than a laptop (outbound 587 is
# commonly blocked on cloud hosts, and that is exactly what this catches):
#   npm run mail:test -w server -- you@acceleronsolutions.io
#
# Optional tuning, sensible defaults in brackets:
# SMTP_REQUIRE_TLS=true          [true]  refuse to send if STARTTLS fails
# SMTP_POOL=true                 [true off serverless] reuse one connection
# SMTP_TIMEOUT_MS=15000          [15000] fail fast instead of hanging
# SMTP_VERIFY_ON_BOOT=true       [true]  check the relay at startup and log it

# ── RECOGNITION MAIL (FR-19, email arm) ─────────────────────────────────────
# Fires the moment a recognition is created, on every channel (WhatsApp bot,
# web console, simulator):
#   To  — the recipient
#   Cc  — the recipient's reporting manager (manager_id in the directory)
#         and the giver
# Skipped silently when the recipient has no email in the directory, when the
# recipient is inactive, and when the row came back flagged by the BR-5
# burst/loop check — a flagged row may yet be struck by the committee.
# RECOGNITION_EMAIL=true         [true]  set false to mute it (e.g. mid-import)
#
# Absolute URL of the web console. Set it and the mail gets a "See it on the
# CHAMP wall" button; leave it unset and the mail simply has no button.
# CONSOLE_URL=https://acceleron-champ-server.vercel.app

# ── ALTERNATIVE: Amazon SES ──────────────────────────────────────────────────
# Either the SES SMTP interface (use the smtp settings above with the SES host
# and your SMTP credentials — no code change), or the SES API:
# EMAIL_PROVIDER=ses
# AWS_REGION=ap-south-1
# (needs `npm i @aws-sdk/client-ses` and the block uncommenting in
#  server/src/modules/auth/mailer.ts; the runtime IAM role needs ses:SendEmail)

# ── WhatsApp Business Platform ────────────────────────────────────────────────
# LOCAL DEFAULT: "simulator" — the in-app phone at /simulator exercises the
# exact same conversation engine; no Meta account needed.
WHATSAPP_PROVIDER=simulator

# PRODUCTION — Meta Cloud API (or a BSP such as Gupshup/Wati/Twilio; see
# README §Enabling WhatsApp). Obtain from Meta Business Manager /
# developers.facebook.com after Business Verification:
# WHATSAPP_PROVIDER=meta
# META_WA_API_VERSION=v20.0
# META_WA_PHONE_NUMBER_ID=<phone-number-id>
# META_WA_TOKEN=<system-user-permanent-access-token>
# META_WA_APP_SECRET=<app-secret-for-webhook-signature-verification>
# META_WA_VERIFY_TOKEN=<any-random-string-you-also-paste-into-the-meta-console>

# OPTION 2 — Gallabox WhatsApp API (https://server.gallabox.com):
# WHATSAPP_PROVIDER=gallabox
# GALLABOX_BASE_URL=https://server.gallabox.com
# GALLABOX_API_KEY=<gallabox-api-key>
# GALLABOX_API_SECRET=<gallabox-api-secret>
# GALLABOX_CHANNEL_ID=<gallabox-whatsapp-channel-id>
# GALLABOX_WEBHOOK_SECRET=<gallabox-webhook-secret>

# ── DarwinBox HRIS sync ───────────────────────────────────────────────────────
# LOCAL DEFAULT: disabled — the app seeds a demo employee directory instead.
DARWINBOX_ENABLED=false
# PRODUCTION — from the DarwinBox admin console / account manager:
# DARWINBOX_ENABLED=true
# DARWINBOX_BASE_URL=https://<tenant>.darwinbox.in
# DARWINBOX_BASIC_AUTH_USER=<username>
# DARWINBOX_BASIC_AUTH_PASS=<password>
# DARWINBOX_API_KEY=<api-key-for-payload>
# DARWINBOX_REPORT_ID=<report-id>

# ── Plant board ───────────────────────────────────────────────────────────────
# The /board page is read-only and login-free (it runs on a kiosk browser).
# Optionally require a token so only the plant screens can load it:
# BOARD_TOKEN=<random-string>   → board URL becomes /board?token=<random-string>

# ── Dev tools ─────────────────────────────────────────────────────────────────
# The WhatsApp simulator API+page. Defaults ON outside production, OFF in
# production. Force with:
# ENABLE_SIMULATOR=true

# ── Outbound messaging policy ─────────────────────────────────────────────────
# The bot is REPLY-ONLY by default: it may message a number only while that
# number is in a conversation they started themselves — i.e. they sent us
# something within SESSION_WINDOW_HOURS. This is what stops the recognition
# notification landing at 2am because a colleague on another shift gave it, and
# it caps the weekly digest to people already talking to the bot.
#
# Set to false to go back to unconditional template broadcasts (FR-19/FR-20
# as originally specified). Suppressed sends are logged, never silent.
PROACTIVE_REQUIRES_SESSION=true
# WhatsApp's own customer-service window is 24h; shorten it if you want the bot
# to go quiet sooner than WhatsApp requires.
SESSION_WINDOW_HOURS=24

# ── Mid-flow inactivity reminder ──────────────────────────────────────────────
# If someone abandons a recognition partway through, they get ONE nudge and
# nothing further. Any new activity re-arms it for the next abandonment.
REMINDERS_ENABLED=true
REMINDER_AFTER_MINUTES=5
# How long an unfinished flow stays resumable (FR-10). Must stay comfortably
# above REMINDER_AFTER_MINUTES or the nudge arrives after the flow has expired.
CONVERSATION_STATE_TTL_MINUTES=30

# ── Scheduled jobs (cron, IST) ────────────────────────────────────────────────
SYNC_CRON=30 2 * * *
FLAGSCAN_CRON=15 3 * * *
DIGEST_CRON=0 9 * * 1
# The reminder sweep. Minute resolution — a coarser expression just makes the
# nudge late. On Vercel this schedule needs a Pro plan; Hobby cron runs daily.
REMINDER_CRON=* * * * *

# ── AWS (production only — all commented for local runs) ─────────────────────
# AWS_REGION=ap-south-1
# Load every secret (DB URL, WhatsApp token, SMTP password…) from AWS Secrets
# Manager at boot instead of from this file:
# AWS_SECRETS_ENABLED=true
# AWS_SECRETS_ID=champ-spot-tool/production
